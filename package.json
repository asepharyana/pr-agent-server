{
	"name": "pr-agent-server",
	"version": "1.6.3",
	"private": true,
	"type": "module",
	"scripts": {
		"dev": "moon run :dev",
		"build": "moon run :build",
		"test": "moon run :test",
		"typecheck": "moon run :typecheck",
		"lint": "biome check .",
		"check": "biome check . && moon run :typecheck && moon run :test",
		"format": "biome check --write .",
		"db:generate": "pnpm -C apps/api drizzle-kit generate",
		"db:push": "pnpm -C apps/api drizzle-kit push",
		"db:migrate": "pnpm -C apps/api tsx src/migrate.ts",
		"db:seed": "pnpm -C apps/api tsx src/db/seed.ts",
		"db:studio": "pnpm -C apps/api drizzle-kit studio"
	},
	"devDependencies": {
		"@biomejs/biome": "2.6.4",
		"@moonrepo/cli": "2.6.5",
		"typescript": "^7.0.2"
	}
}
